# Shared school database. The bootstrap script creates the syllabus tables here.
DATABASE_URL=postgresql://swais:swais_secret@localhost:5434/syllabus_planner
SARASWATI_DATABASE_URL=postgresql://swais:swais_secret@localhost:5434/syllabus_planner

SECRET_KEY=dev-syllabus-planner-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010

CORS_ORIGINS=http://localhost:3000

# Fixed school used when APP_ENV=development, so Swagger on localhost resolves
# before platform.tenant_domains has a row for this host.
DEV_TENANT_ID=11111111-1111-4111-8111-111111111111

# Optional. When set, POST /lesson-plans/current asks this service for the
# plan body. When empty, the API still returns a plan for the current topic.
AI_SERVICE_URL=
PERIOD_MINUTES=45

DB_SERVICE_SLOTS=12
DB_RESERVE=0.2
